# Copy to .env and fill in. .env is git-ignored; never commit a real key.

# Required for live runs (`pnpm eval run`) and for drafting the dataset (scripts/draft-dataset.ts).
# NOT needed to re-score committed runs offline (`pnpm eval score`, `pnpm eval compare`).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
